# ============================================================
# LINE Lottery & Wheel Spin System - Environment Variables
# Copy to .env and fill in real values:  cp .env.example .env
# ============================================================

# ---- App ----
NODE_ENV=production
PORT=3000
TZ=Asia/Bangkok
FRONTEND_URL=http://localhost
CORS_ORIGIN=http://localhost

# ---- MySQL ----
DB_HOST=mysql
DB_PORT=3306
DB_NAME=line_lottery
DB_USER=line_lottery
DB_PASSWORD=change_me_strong_db_password
MYSQL_ROOT_PASSWORD=change_me_strong_root_password

# ---- JWT Auth ----
JWT_SECRET=change_me_to_a_long_random_string_at_least_32_chars
JWT_EXPIRES_IN=1d

# ---- Default Admin (seeded on first boot) ----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_admin_password_strong

# ---- LINE Messaging API ----
# From LINE Developers console: https://developers.line.biz
LINE_CHANNEL_ACCESS_TOKEN=your_channel_access_token
LINE_CHANNEL_SECRET=your_channel_secret

# Public HTTPS URL of the webhook (used in Flex message buttons)
# e.g. https://your-domain.com
PUBLIC_BASE_URL=http://localhost

# Image used as the trophy hero in the winner Flex message.
# Host this image somewhere public (or use a CDN).
LINE_TROPHY_IMAGE_URL=https://em-content.zobj.net/source/microsoft-teams/337/trophy_1f3c6.png
