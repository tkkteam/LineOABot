# Backend local development environment
# Copy to .env: cp .env.example .env

NODE_ENV=development
PORT=3000
TZ=Asia/Bangkok

# DB (local MySQL or the docker-compose `mysql` service)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=line_lottery
DB_USER=line_lottery
DB_PASSWORD=change_me_strong_db_password

# JWT
JWT_SECRET=change_me_to_a_long_random_string_at_least_32_chars
JWT_EXPIRES_IN=1d

# Default admin seeded on first boot
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin999

# LINE Messaging API
LINE_CHANNEL_ACCESS_TOKEN=B4hwgPc4lvPpBUGdQthGFsjDVcqHHBczVFtc+GDFXPWhNBUA8WMjgqUdcKSo/b7GHa0O8OnotH8kyNokPnnLzD6Uc8Zv9XrWXYG4JcUwtJeaCWX1j1pIJqAKtKFw/Adkmbp3nVjLv2Abv>
LINE_CHANNEL_SECRET=1a5fd8e79ba8ca6320738ec0cbeb5ce7

# Public URLs
FRONTEND_URL=http://localhost:5173
PUBLIC_BASE_URL=http://localhost:3000
